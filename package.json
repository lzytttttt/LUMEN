{
  "name": "lumen-deck",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "LUMEN 幕光 — AI 原生 HTML 演示工作台",
  "scripts": {
    "dev": "node --import=./scripts/watch-guard.mjs ./node_modules/vite/bin/vite.js --port 5273 --strictPort",
    "predev": "node scripts/build-player.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/build-player.mjs",
    "build:player": "node scripts/build-player.mjs",
    "player:build": "vite build -c vite.player.config.ts",
    "preview": "vite preview --port 5273 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "snapshot": "node scripts/snapshot.mjs",
    "lint:i18n": "vitest run tests/unit/i18n.test.ts",
    "deploy:preview": "npx --yes vercel",
    "deploy:prod": "npx --yes vercel --prod"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "^6",
    "@codemirror/theme-one-dark": "^6",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "html-to-image": "1.11.13",
    "idb-keyval": "6.3.0",
    "immer": "11.2.9",
    "lucide-react": "^1.62.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.186.1",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "license": "CC-BY-NC-4.0",
  "engines": {
    "node": "22.x"
  }
}
