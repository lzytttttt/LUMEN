: \"Preview\",\n    \"panel.bound\": \"Bound chart\",\n    \"panel.unbound\": \"No bound data\",\n    \"type.bar\": \"Bar\",\n    \"type.line\": \"Line\",\n    \"type.donut\": \"Donut\",\n    \"type.stacked\": \"Stacked\",\n    \"action.insert\": \"Insert chart\",\n    \"action.update\": \"Update data\",\n    \"action.detach\": \"Detach data\",\n    \"action.redraw\": \"Redraw selected chart\",\n    \"action.open\": \"Open charts panel\",\n    \"error.csvQuote\": \"Unclosed quote on line {line}\",\n    \"error.csvColumns\": \"Column count mismatch on line {line}\",\n    \"error.dataset\": \"Dataset exceeds {max} rows — truncated\",\n    \"error.notBound\": \"This chart has no bound data\",\n    \"error.empty\": \"Paste some data first\",\n    \"error.badJson\": \"Unrecognised JSON structure\",\n    \"error.tooFew\": \"At least 2 rows are required\",\n    \"error.validRatio\": \"Less than half of the values are numeric — fix the data first\",\n    \"error.noDeck\": \"Open a deck first\",\n    \"error.writeDenied\": \"No permission to change the deck\",\n    \"lint.series\": \"{count} series exceed the limit of {max}\",\n    \"lint.axis\": \"Fewer than 2 categories or missing axis labels\",\n    \"lint.contrast\": \"Chart contrast is {ratio}:1\",\n    \"toast.inserted\": \"Chart inserted (undoable)\",\n    \"toast.updated\": \"Chart data updated\",\n    \"toast.detached\": \"Data binding detached\",\n    \"toast.evicted\": \"More than 24 chart datasets — the least recently changed was removed\",\n    \"a11y.panel\": \"ChartKit panel\",\n    \"a11y.input\": \"Paste table data\",\n    \"a11y.preview\": \"{type} chart with {count} categories\",\n    \"a11y.tabs\": \"Chart type\"\n  }\n}\n"}}