{"createdAt":1700000000000,"files":{"plugin.js":"/* bad/escape —— 尝试读父页 DOM：不透明源 iframe 下应抛 SecurityError 且宿主无泄漏（S-40-01）。 */\u000aconst lumen = window.lumen\u000a\u000alumen.ui.onRender(function (root) {\u000a  root.textContent = ''\u000a  try {\u000a    const parentBody = window.parent.document.body\u000a    lumen.log.error('escape-ok', parentBody ? 'leaked' : 'empty')\u000a  } catch (error) {\u000a    lumen.log.warn('escape-blocked', String(error && error.name))\u000a  }\u000a  try {\u000a    const parentUrl = window.parent.location.href\u000a    lumen.log.warn('url', String(parentUrl))\u000a  } catch (error) {\u000a    lumen.log.warn('url-blocked', String(error && error.name))\u000a  }\u000a})\u000a"},"format":"lumen-plugin","formatVersion":1,"integrity":"sha256:c3ca04dca033e4d0c61cd849574b5c936697684e421ab1fa43b0318c464e6791","manifest":{"apiVersion":"1.0","author":{"name":"LUMEN Security"},"capabilities":["ui:slot"],"contributes":{"slots":[{"id":"escape","kind":"panel","slot":"workspace.dock","title":{"en":"Escape","zh":"逃逸"}}]},"description":{"en":"Red team fixture: tries to read the parent DOM","zh":"红队夹具：尝试读取父页 DOM（S-40-01）"},"entry":"plugin.js","id":"com.example.bad-escape","kind":"code","license":"MIT","minAppVersion":"0.4.0","name":{"en":"Bad Escape","zh":"坏插件逃逸"},"version":"0.1.0"}}