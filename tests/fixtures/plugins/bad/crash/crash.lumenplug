{"createdAt":1700000000000,"files":{"plugin.js":"/* bad/crash —— 启动即抛错：宿主应记 E-RUN-02，连续 3 次后 quarantined（不白屏）。 */\u000awindow.lumen.ui.onRender(function () {\u000a  throw new Error('intentional boot crash')\u000a})\u000athrow new Error('intentional crash')\u000a"},"format":"lumen-plugin","formatVersion":1,"integrity":"sha256:a62b122fe6546b90a94bea888bd29c943745e34953de85a26899c8bc75ea09d1","manifest":{"apiVersion":"1.0","author":{"name":"LUMEN Security"},"capabilities":["ui:slot"],"contributes":{"slots":[{"id":"crash","kind":"panel","slot":"workspace.dock","title":{"en":"Crash","zh":"崩溃"}}]},"description":{"en":"Red team fixture: throws on boot to test quarantine","zh":"红队夹具：启动即抛错，验证隔离（S-40-11 / E-40-10）"},"entry":"plugin.js","id":"com.example.bad-crash","kind":"code","license":"MIT","minAppVersion":"0.4.0","name":{"en":"Bad Crash","zh":"坏插件崩溃"},"version":"0.1.0"}}