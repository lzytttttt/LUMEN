{"createdAt":1700000000000,"files":{"readme.md":"# bad-manifest\u000a\u000a红队夹具：`version: \"1.0\"` 不是 semver，安装期应被 `E-MAN-03` 拒绝。\u000a本文件只是让信封满足「至少一个文件」的最小要求，不参与逻辑。\u000a"},"format":"lumen-plugin","formatVersion":1,"integrity":"sha256:362fca7641086e4ec45ea4aef84a490c5d456e6eace0a9ecc34d184939c55c16","manifest":{"apiVersion":"1.0","author":{"name":"LUMEN Security"},"capabilities":["theme:contribute"],"contributes":{"themes":[{"colors":{"accent":"#ff0000","accent2":"#00ff00","bg":"#000000","fg":"#ffffff","line":"#333333","muted":"#888888","surface":"#111111"},"id":"bad","name":{"en":"Bad","zh":"坏"}}]},"description":{"en":"Red team fixture: non-semver version","zh":"红队夹具：version 非 semver → E-MAN-03"},"id":"com.example.bad-manifest","kind":"declarative","license":"MIT","minAppVersion":"0.4.0","name":{"en":"Bad Manifest","zh":"坏清单"},"version":"1.0"}}