{"createdAt":1700000000000,"files":{"plugin.js":"/* bad/flood —— RPC 洪水：宿主令牌桶 120/s + 60s 内 3 次 → 挂起帧（S-40-11）。 */\u000aconst lumen = window.lumen\u000a\u000alumen.ui.onRender(function (root) {\u000a  root.textContent = ''\u000a  let sent = 0\u000a  const pump = function () {\u000a    for (let index = 0; index < 2000; index += 1) {\u000a      sent += 1\u000a      lumen.theme.get().catch(function () {\u000a        return undefined\u000a      })\u000a    }\u000a    lumen.log.warn('flood sent', sent)\u000a    window.setTimeout(pump, 50)\u000a  }\u000a  pump()\u000a})\u000a"},"format":"lumen-plugin","formatVersion":1,"integrity":"sha256:f6270f3cd32b4fe01e18fb968ebd1f98010d05a56c9bbe77de7dd6d0a097b769","manifest":{"apiVersion":"1.0","author":{"name":"LUMEN Security"},"capabilities":["ui:slot","deck:read"],"contributes":{"slots":[{"id":"flood","kind":"panel","slot":"workspace.dock","title":{"en":"Flood","zh":"洪水"}}]},"description":{"en":"Red team fixture: RPC flood to test rate limiting","zh":"红队夹具：RPC 洪水，验证 120/s 令牌桶（S-40-11）"},"entry":"plugin.js","id":"com.example.bad-flood","kind":"code","license":"MIT","minAppVersion":"0.4.0","name":{"en":"Bad Flood","zh":"坏插件洪水"},"version":"0.1.0"}}