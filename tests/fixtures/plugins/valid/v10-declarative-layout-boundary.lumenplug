{
  "format": "lumen-plugin",
  "formatVersion": 1,
  "createdAt": 1717200000000,
  "manifest": {
    "id": "com.qatools.fx10",
    "name": {
      "zh": "契约夹具",
      "en": "Contract Fixture"
    },
    "version": "0.1.0",
    "apiVersion": "1.0",
    "minAppVersion": "0.4.0",
    "kind": "declarative",
    "author": {
      "name": "QA Fixtures"
    },
    "description": {
      "zh": "仅用于 LUMEN 插件契约测试的夹具包。",
      "en": "Fixture package for LUMEN plugin contract tests."
    },
    "license": "MIT",
    "capabilities": [
      "ui:layout"
    ],
    "contributes": {
      "layoutPresets": [
        {
          "id": "focus-layout",
          "name": {
            "zh": "专注布局",
            "en": "Focus layout"
          },
          "apply": {
            "railWidth": 180,
            "panelWidth": 420,
            "dockHeight": 240,
            "hideRail": false,
            "hideInspector": false,
            "leftTab": "outline",
            "rightMode": "composer",
            "inspectorTab": "props",
            "showGrid": true,
            "density": "compact"
          }
        }
      ]
    }
  },
  "files": {
    "readme.md": "# QA fixture\n\n仅用于 LUMEN 插件契约测试，无外部资源。\n"
  },
  "integrity": "sha256:f5adac95b1d1a1894d5f7c7bd5e7bf0dbd2b6c73af0a159cebcaa0c2376877bc"
}
