{
  "format": "lumen-plugin",
  "formatVersion": 1,
  "createdAt": 1717200000000,
  "manifest": {
    "id": "com.qatools.fx14",
    "name": {
      "zh": "契约夹具",
      "en": "Contract Fixture"
    },
    "version": "0.1.0",
    "apiVersion": "1.0",
    "minAppVersion": "0.4.0",
    "kind": "code",
    "author": {
      "name": "QA Fixtures"
    },
    "description": {
      "zh": "仅用于 LUMEN 插件契约测试的夹具包。",
      "en": "Fixture package for LUMEN plugin contract tests."
    },
    "license": "MIT",
    "capabilities": [
      "ui:slot"
    ],
    "contributes": {
      "slots": [
        {
          "id": "qa-entry",
          "slot": "workspace.topbar",
          "title": {
            "zh": "QA",
            "en": "QA"
          },
          "icon": "icon.svg",
          "kind": "inline",
          "open": {
            "slot": "dialog",
            "contributionId": "qa-about"
          }
        },
        {
          "id": "qa-about",
          "slot": "dialog",
          "title": {
            "zh": "关于 QA",
            "en": "About QA"
          },
          "kind": "modal"
        }
      ]
    },
    "entry": "plugin.js",
    "icon": "icon.svg"
  },
  "files": {
    "plugin.js": "// QA fixture: minimal code plugin entry.\nconst lumen = window.lumen\nlumen.meta.ready({ ok: true })\nlumen.ui.toast({ zh: '已加载', en: 'Loaded' })\n",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><rect width=\"24\" height=\"24\" rx=\"6\" fill=\"var(--d-accent)\"/></svg>"
  },
  "integrity": "sha256:7134c429c321452a475477a88c572f85eaf9d55104e6cdef01175b8036bdc210"
}
