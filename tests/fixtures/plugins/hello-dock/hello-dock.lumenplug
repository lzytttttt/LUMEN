{"createdAt":1700000000000,"files":{"plugin.js":"/* hello-dock —— 最小代码式插件：在 workspace.dock 里渲染一行看板（E-40-03 夹具）。 */\u000aconst lumen = window.lumen\u000a\u000aif (lumen && lumen.ui) {\u000a  const paint = function (root, ctx) {\u000a    root.textContent = ''\u000a    root.setAttribute('data-hello-dock', 'ready')\u000a    root.setAttribute('data-plugin-lang', ctx.locale)\u000a    const card = lumen.ui.el('div', { class: 'lumen-card' })\u000a    const title = lumen.ui.el('strong', { text: ctx.locale === 'zh' ? '你好，看板' : 'Hello, dock' })\u000a    const badge = lumen.ui.el('span', { class: 'lumen-badge', text: 'hello-dock 0.1.0' })\u000a    card.appendChild(title)\u000a    card.appendChild(badge)\u000a    root.appendChild(card)\u000a    lumen.log.info('hello-dock rendered', ctx.width + 'x' + ctx.height)\u000a  }\u000a  lumen.ui.onRender(paint)\u000a}\u000a"},"format":"lumen-plugin","formatVersion":1,"integrity":"sha256:dabd861463d332f46682489de7b2fa016ea870a4b1ef68c71981a91c2a61a09b","manifest":{"apiVersion":"1.0","author":{"name":"LUMEN Samples"},"capabilities":["ui:slot"],"contributes":{"slots":[{"id":"dock","kind":"panel","order":10,"size":{"h":260},"slot":"workspace.dock","title":{"en":"Hello Dock","zh":"你好看板"}}]},"description":{"en":"Code plugin: renders a minimal board in the dock","zh":"代码式插件：在底部托盘渲染一行最小看板"},"entry":"plugin.js","id":"com.example.hello-dock","kind":"code","license":"MIT","minAppVersion":"0.4.0","name":{"en":"Hello Dock","zh":"你好看板"},"version":"0.1.0"}}