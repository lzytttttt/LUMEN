{"createdAt":1700000000000,"files":{"plugin.js":"/* hello-topbar —— 代码式插件：顶栏 inline 入口 → 打开 dialog 帧（E-40-14 / 插槽单测夹具）。 */\u000aconst lumen = window.lumen\u000a\u000aif (lumen && lumen.ui) {\u000a  lumen.ui.onRender(function (root, ctx) {\u000a    root.textContent = ''\u000a    root.setAttribute('data-hello-topbar', 'ready')\u000a    const card = lumen.ui.el('div', { class: 'lumen-card' })\u000a    const title = lumen.ui.el('strong', { text: ctx.locale === 'zh' ? '顶栏你好' : 'Hello from the topbar' })\u000a    const close = lumen.ui.el('button', { class: 'lumen-button', type: 'button', text: ctx.locale === 'zh' ? '关闭' : 'Close' })\u000a    close.addEventListener('click', function () {\u000a      lumen.ui.closePanel({ slot: 'dialog' })\u000a    })\u000a    card.appendChild(title)\u000a    card.appendChild(close)\u000a    root.appendChild(card)\u000a  })\u000a}\u000a"},"format":"lumen-plugin","formatVersion":1,"integrity":"sha256:73834b1773d832d3a14bda1c24a3869cd44673c89288c1f95f586cb2c87ad9d9","manifest":{"apiVersion":"1.0","author":{"name":"LUMEN Samples"},"capabilities":["ui:slot"],"contributes":{"slots":[{"id":"entry","kind":"inline","open":{"contributionId":"hello-dialog","slot":"dialog"},"order":10,"slot":"workspace.topbar","title":{"en":"Hello","zh":"你好"}},{"id":"hello-dialog","kind":"modal","size":{"h":280,"w":420},"slot":"dialog","title":{"en":"Hello Topbar","zh":"你好顶栏"}}]},"description":{"en":"Code plugin: a topbar entry that opens a dialog","zh":"代码式插件：顶栏入口按钮 + 点击打开对话框"},"entry":"plugin.js","id":"com.example.hello-topbar","kind":"code","license":"MIT","minAppVersion":"0.4.0","name":{"en":"Hello Topbar","zh":"你好顶栏"},"version":"0.1.0"}}