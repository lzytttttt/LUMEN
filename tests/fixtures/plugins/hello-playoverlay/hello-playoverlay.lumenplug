{"createdAt":1700000000000,"files":{"plugin.js":"/* hello-playoverlay —— 代码式插件：play.overlay 上的排练计时（V-40-13）。 */\u000aconst lumen = window.lumen\u000a\u000aif (lumen && lumen.ui) {\u000a  var startedAt = 0\u000a  var ticker = null\u000a\u000a  lumen.ui.onRender(function (root, ctx) {\u000a    root.textContent = ''\u000a    root.setAttribute('data-hello-playoverlay', 'ready')\u000a    if (ticker) {\u000a      clearInterval(ticker)\u000a      ticker = null\u000a    }\u000a    if (!startedAt) startedAt = Date.now()\u000a    const box = lumen.ui.el('div', { class: 'lumen-badge', 'aria-live': 'polite' })\u000a    const paint = function () {\u000a      const seconds = Math.floor((Date.now() - startedAt) / 1000)\u000a      const minutes = Math.floor(seconds / 60)\u000a      box.textContent = (ctx.locale === 'zh' ? '排练 ' : 'Rehearsal ') + minutes + ':' + String(seconds % 60).padStart(2, '0')\u000a    }\u000a    paint()\u000a    ticker = setInterval(paint, 1000)\u000a    root.appendChild(box)\u000a  })\u000a\u000a  lumen.events.on('play:stop', function () {\u000a    if (ticker) {\u000a      clearInterval(ticker)\u000a      ticker = null\u000a    }\u000a  })\u000a}\u000a"},"format":"lumen-plugin","formatVersion":1,"integrity":"sha256:1d1c972aa413b85863c8657aca5037b0da8d542b456761bfffc3e9dcbcad0199","manifest":{"apiVersion":"1.0","author":{"name":"LUMEN Samples"},"capabilities":["ui:slot"],"contributes":{"slots":[{"id":"timer","kind":"overlay","order":10,"slot":"play.overlay","title":{"en":"Rehearsal timer","zh":"排练计时"}}]},"description":{"en":"Code plugin: a rehearsal timer overlay during playback","zh":"代码式插件：播放态右上角排练计时（V-40-13 夹具）"},"entry":"plugin.js","id":"com.example.hello-playoverlay","kind":"code","license":"MIT","minAppVersion":"0.4.0","name":{"en":"Hello Rehearsal","zh":"你好排练计时"},"version":"0.1.0"}}